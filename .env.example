# LoveCry — copy to .env / Hostinger env panel
# Never commit real secrets.

# ——— Core ———
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME"
NEXT_PUBLIC_SITE_URL=https://www.lovecry.ca
# Hostinger production MUST set: APP_ENV=production
APP_ENV=development

# ——— Admin authentication ———
# Required in production
AUTH_SECRET=
TOKEN_HASH_SECRET=
# Bootstrap first admin when no AdminUser rows exist (dev/staging)
ADMIN_BOOTSTRAP_EMAIL=admin@lovecry.ca
ADMIN_BOOTSTRAP_PASSWORD=
# Deprecated temporary shared password — non-production compatibility only; never use lovecry-admin in production
ADMIN_TEMP_PASSWORD=

# ——— Zeffy (keep sync false until live API is verified) ———
ZEFFY_API_KEY=
ZEFFY_ORGANIZATION_ID=
ZEFFY_API_BASE_URL=https://api.zeffy.com
ZEFFY_DEFAULT_CAMPAIGN_ID=
ZEFFY_DEFAULT_EMBED_URL=
ZEFFY_SYNC_ENABLED=false

# Mock donation pay — MUST be false in production
ALLOW_MOCK_PAY=false

# ——— Official charitable receipting ———
# Keep false until authorized signatory and legal info are complete
CHARITY_RECEIPTING_ENABLED=false
CHARITY_LEGAL_NAME=LoveCry The Street Kids Organization
CHARITY_REGISTRATION_NUMBER=892528365RR0001
CHARITY_ADDRESS=150 Cosburn Ave., East York, ON M4J 2L9
CHARITY_ISSUANCE_LOCATION=Toronto, Ontario
CHARITY_AUTHORIZED_SIGNATORY=
CHARITY_RECEIPT_THRESHOLD_CENTS=2000

# ——— Email (Resend) ———
EMAIL_PROVIDER=resend
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=

# ——— Security / ops ———
REDIS_URL=
SENTRY_DSN=
CRON_SECRET=
ENCRYPTION_KEY=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ——— Counselling / Book Now ———
APP_TIME_ZONE=America/Toronto
BOOKING_HOLD_MINUTES=10
DEFAULT_APPOINTMENT_DURATION_MINUTES=60
DEFAULT_BUFFER_BEFORE_MINUTES=0
DEFAULT_BUFFER_AFTER_MINUTES=15
MINIMUM_BOOKING_NOTICE_HOURS=24
MAXIMUM_BOOKING_WINDOW_DAYS=60
CONSENT_DEADLINE_HOURS=24
CONSENT_REQUIRED_BEFORE_CONFIRM=false
# Leave empty until client verifies counselling location (do not assume charity mailing address)
COUNSELLING_IN_PERSON_LOCATION=
COUNSELLING_CRISIS_MESSAGE=

# ——— Google Calendar OAuth (server-only; never NEXT_PUBLIC_) ———
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.lovecry.ca/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=America/Toronto
# Production fail-closed: booking requires CONNECTED Calendar (defaults on when APP_ENV=production)
GOOGLE_CALENDAR_REQUIRED=

# Deprecated service-account Calendar vars (superseded by OAuth above)
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_WORKSPACE_ADMIN_EMAIL=
GOOGLE_COUNSELLING_CALENDAR_ID=

# ——— Google Drive (separate from Calendar OAuth; not production-wired) ———
GOOGLE_SIGNED_CONSENT_FOLDER_ID=
GOOGLE_CONSENT_TEMPLATE_FOLDER_ID=

# ——— Events CMS images ———
# There is no Cloudinary/S3 uploader. Admins paste https:// URLs or /public paths
# (for example /event (1).jpg). Do not store production uploads on the Next.js filesystem.